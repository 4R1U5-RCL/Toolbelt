#!/usr/bin/env python3
"""Executable shim so the package can be run without installing it.

    ./bin/poller run --config examples/kaggle-submissions.json
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from poller.cli import main  # noqa: E402  (path setup must come first)

if __name__ == "__main__":
    sys.exit(main())
