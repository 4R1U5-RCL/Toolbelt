  "description": "The triage vocabulary already in use across the studio: attended, deferred, mute. Action codes match the existing receivers deliberately.",
  "requires": [
    "title",
    "id"
  ],
  "defaults": {
    "body": "",
    "entity": ""
  },
  "title": "{emoji} {title}",
