    [
      {
        "text": "✅ Attended",
        "action": "att",
        "entity": "{entity}",
        "id": "{id}"
      },
      {
        "text": "⏳ Deferred",
        "action": "def",
        "entity": "{entity}",
        "id": "{id}"
      },
      {
        "text": "🔕 Mute",
        "action": "mute",
        "entity": "{entity}",
        "id": "{id}"
      }
    ]
  ]
}
